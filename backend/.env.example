APP_NAME="MasalNest"
DEBUG=False

# ── Database ────────────────────────────────────────────────────────
# Local development (default): SQLite
DATABASE_URL="sqlite+aiosqlite:///./masal_ai.db"

# Production (Neon PostgreSQL): paste your Neon connection string.
# The app auto-converts postgres:// or postgresql:// to postgresql+asyncpg://
# DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ── CORS ────────────────────────────────────────────────────────────
# Comma-separated list or JSON array of allowed origins.
# For production, include your Vercel frontend URL.
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# ── Groq AI ─────────────────────────────────────────────────────────
# Required for real LLM invocations (analysis, chat, extraction)
GROQ_API_KEY="your-groq-api-key-here"
GROQ_MODEL_NAME="openai/gpt-oss-120b"
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=0

# ── Scoring thresholds ──────────────────────────────────────────────
SCORE_HOT_THRESHOLD=70
SCORE_WARM_THRESHOLD=40
